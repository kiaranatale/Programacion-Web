# URL y clave pública del proyecto Supabase (seguras para el navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exclusiva del servidor. Nunca exponer en variables NEXT_PUBLIC ni en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Solo para scripts SQL ejecutados con psql; no la consume Next.js.
SUPABASE_DB_URL=

# Mercado Pago sandbox: se utilizarán al implementar el flujo de pagos.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=